library(ggplot2)
install.packages("tidyverse")
library(ggplot2)
pathway = read.table("C://Users/23648/Desktop/20.csv",header=T,sep=",")
pathway = read.table("C://Users/23648/Desktop/20.csv",header=T,sep=",")
pathway = read.table("C:\Program Files\R.csv",header=T,sep=",")
pathway = read.table("C:/Program Files/R/20.csv",header=T,sep=",")
pathway = read.table("C:/for R/20.csv",header=T,sep=",")
p = ggplot(pathway,aes(RichFactor,Pathway))
p = p + geom_point()
p= p + geom_point(aes(size=GeneCounts))
pbubble = p + geom_point(aes(size=GeneCounts,color=-1*log10(pvalue)))
pbubble = pbubble + scale_colour_gradient(low="green",high="red")
pr = pbubble + scale_colour_gradient(low="green",high="red") + labs(color=expression(-log[10](pvalue)),size="Gene counts",x="RichFactor",title="G)20bp")
pr = pr + theme_bw()
ggsave("C:/for R/20.jpg",height=4)
ggsave("C:/for R/20.jpg",height=4)
View(pathway)
RichFactor
