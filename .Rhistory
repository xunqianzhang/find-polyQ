library(ggplot2)
library(dplyr)
library(readr)
df = read_csv("C:/for R/20.csv")
df <-read_csv("C:/for R/20.csv")
ggplot(df, aes(x = logFDR,
y = reorder(GO_term, logFDR),
size = `upload_1 (fold Enrichment)`,
color = `upload_1 (FDR)`)) +
geom_point(alpha = 0.8) +
scale_color_gradient(low = "red", high = "blue", trans = "log") +
scale_size(range = c(3, 10)) +
labs(title = "GO Enrichment Bubble Plot",
x = "-log10(FDR)",
y = "GO Term",
size = "Fold Enrichment",
color = "FDR") +
theme_minimal()
df <- df %>%
mutate(GO_term = sub(" \\(GO:.*\\)", "", `GO biological process complete`),
logFDR = -log10(`upload_1 (FDR)`))
ggplot(df, aes(x = logFDR,
y = reorder(GO_term, logFDR),
size = `upload_1 (fold Enrichment)`,
color = `upload_1 (FDR)`)) +
geom_point(alpha = 0.8) +
scale_color_gradient(low = "red", high = "blue", trans = "log") +
scale_size(range = c(3, 10)) +
labs(title = "GO Enrichment Bubble Plot",
x = "-log10(FDR)",
y = "GO Term",
size = "Fold Enrichment",
color = "FDR") +
theme_minimal()
ggsave("C:/for R/20.jpg",height=400)
