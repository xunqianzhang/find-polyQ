library(clusterProfiler)
if (!require("BiocManager", quietly = TRUE))
install.packages("BiocManager")
BiocManager::install("clusterProfiler")
library(ggplot2)
library(clusterProfiler)
df <- read_csv("C:/for R/20.csv")
df <-read.table("C:/for R/20.csv",header=T,sep=",")
df<- simplify(df, cutoff = 0.7, by = "p.adjust", select_fun = min)
library(org.Dd.eg.db)
df_simple <- simplify(df,
cutoff = 0.7,
by = "p.adjust",
select_fun = min,
measure = "Wang")
if (!require("BiocManager", quietly = TRUE))
install.packages("BiocManager")
BiocManager::install("simplifyEnrichment")
library(simplifyEnrichment)
View(df)
simplifyGO(df)
simplifyGO(df)
df$GO_ID <- sub(".*\\((GO:\\d+)\\).*", "\\1", df$GO.biological.process.complete)
fdr_vector <- df$upload_1..FDR.
names(fdr_vector) <- df$GO_ID
simplifyGO(fdr_vector)
mat = GO_similarity(df$GO_ID)
simplifyGO(mat,fdr_vector)
View(df)
